# Optional Firebase configuration. Leave unset to run the offline-first local demo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional Supabase Auth fallback. If Firebase Google sign-in fails, the app falls back to Supabase Google OAuth.
# Configure the Google provider and redirect URLs in the Supabase dashboard before enabling these values.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional future modular AI service. When blank, the procedural local engine is used.
VITE_AI_ENGINE_URL=
